# 默认使用真实 /api/tasks；本地体验完整生成流程时改为 mock。
VITE_GENERATION_MODE=real

# 云端模式需完成后端与 Google 配置后再启用；未配置时继续使用本地模式。
VITE_CLOUD_MODE=disabled
# 可独立开启账号；云同步开启时也必须开启账号。
VITE_AUTH_MODE=disabled
VITE_SUPABASE_URL=https://gnrhyahjegvcicektebh.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Vercel 中旧版 VITE_ 变量若被保存为 Secret 且不可编辑，可使用以下 Config 变量覆盖。
VITE_AIGC_SUPABASE_URL=
VITE_AIGC_SUPABASE_PUBLISHABLE_KEY=

# 以下仅服务端可用，不得使用 VITE_ 前缀。
SUPABASE_URL=https://gnrhyahjegvcicektebh.supabase.co
SUPABASE_PUBLISHABLE_KEY=
AIGC_DATABASE_URL=
# 每个环境使用独立的 32 字节随机 Base64 加密主密钥；不要使用 VITE_ 前缀。
AIGC_CREDENTIAL_KEY_V1=
# local、preview 或 production；Vercel 自动使用 VERCEL_ENV。
AIGC_RUNTIME_SCOPE=local
# 定时清理接口的 Bearer 密钥；Vercel Cron 会自动附加。
CRON_SECRET=
R2_ACCOUNT_ID=
R2_BUCKET=pixel-aigc-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 腾讯云数据万象。四项都填上之后，智能抠图才会离开「即将上线」，转比例的智能裁剪也会调用主体检测。
# 抠图使用 GoodsMatting，主体检测使用 AIObjectDetect。密钥只放服务端。
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=

# 仅本地管理命令使用；不部署到 Vercel。
AIGC_ADMIN_DATABASE_URL=
# 仅本地 PostgreSQL 测试允许关闭 TLS；云端保持 false。
AIGC_DB_LOCAL=false
