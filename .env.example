# 默认使用真实 /api/tasks；本地体验完整生成流程时改为 mock。
VITE_GENERATION_MODE=real

# 云端模式需完成后端与 Google 配置后再启用；未配置时继续使用本地模式。
VITE_CLOUD_MODE=disabled
# 可独立开启账号；云同步开启时也必须开启账号。
VITE_AUTH_MODE=disabled
# 自定义 Auth 域名须先在 Supabase 激活，再替换 URL；切换步骤见 docs/auth-domain-branding.md。
VITE_SUPABASE_URL=https://gnrhyahjegvcicektebh.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Vercel 中旧版 VITE_ 变量若被保存为 Secret 且不可编辑，可使用以下 Config 变量覆盖。
# 前端优先读取 VITE_AIGC_SUPABASE_URL；切换域名时须检查同一环境中的覆盖值。
VITE_AIGC_SUPABASE_URL=
VITE_AIGC_SUPABASE_PUBLISHABLE_KEY=

# 以下仅服务端可用，不得使用 VITE_ 前缀。
SUPABASE_URL=https://gnrhyahjegvcicektebh.supabase.co
SUPABASE_PUBLISHABLE_KEY=
AIGC_DATABASE_URL=
# 每个环境使用独立的 32 字节随机 Base64 加密主密钥；不要使用 VITE_ 前缀。
AIGC_CREDENTIAL_KEY_V1=
# local、preview 或 production；Vercel 自动使用 VERCEL_ENV。
AIGC_RUNTIME_SCOPE=local
# 定时清理接口的 Bearer 密钥；Vercel Cron 会自动附加。
CRON_SECRET=
R2_ACCOUNT_ID=
R2_BUCKET=pixel-aigc-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 腾讯云数据万象。四项都填上之后，智能抠图和智能选区才会离开「即将上线」，转比例的智能裁剪也会调用主体检测。
# 抠图和智能选区使用 GoodsMatting，主体检测使用 AIObjectDetect。密钥只放服务端。
# 商品抠图限制：PNG/JPEG、10MB 以内、边长 32 到 7680×4320。智能选区会先把长边收到 1280 再请求，并缓存同一张图的抠图结果。
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=

# 阿里云百炼万相 wanx2.1-imageedit。同一把 Key 用于智能扩展（expand）、消除和重绘（description_edit_with_mask）。
# 密钥只放服务端，不要用 VITE_ 前缀。北京地域，约 0.14 元/张，同时最多 2 个任务。
# 默认请求 https://dashscope.aliyuncs.com。生产建议改用业务空间专属域名（华北2 北京）：
# DASHSCOPE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
# 只填 origin，不要带 /api/v1 路径；末尾斜杠可有可无。未配置或为空则回退公共域名。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
# 消除输入默认按处理后图片大小自动选择；联调时可设为 inline 或 url。
DASHSCOPE_ERASE_INPUT_MODE=

# 千问文生图 qwen-image-3.0 / qwen-image-3.0-pro。默认关闭，不影响现有 GPT Image 2。
# 打开前确认百炼账号已开通对应模型，并且 Key、业务空间、地域一致。P0 只接入异步文生图。
# 未设置 QWEN_IMAGE_API_KEY / QWEN_IMAGE_BASE_URL 时回退 DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL。
QWEN_IMAGE_ENABLED=false
QWEN_IMAGE_API_KEY=
QWEN_IMAGE_BASE_URL=
# 逗号分隔。默认两个都允许。只填 qwen-image-3.0 可先不开放 Pro（Pro 只有 5 RPM）。
QWEN_IMAGE_MODELS=
QWEN_IMAGE_PROMPT_EXTEND=true
# 未设置时跟随每次请求的「自动扩写」，缺省关闭。只有 true/false/1/0 才强制覆盖画布开关。
# 空值和其他写法都当作未设置。QWEN_IMAGE_PROMPT_EXTEND=false 时思考一律关闭。
# Preview 不要把本变量设成 false，否则画布开关无法打开思考。
QWEN_IMAGE_THINKING=
QWEN_IMAGE_TASK_TIMEOUT_MS=300000
QWEN_IMAGE_POLL_INTERVAL_MS=3000
QWEN_IMAGE_INITIAL_POLL_DELAY_MS=3000
QWEN_IMAGE_MAX_PARALLEL=1
QWEN_IMAGE_REQUEST_TIMEOUT_MS=30000
# 只影响千问。消除/重绘/扩图仍用 dashscope.ts 的 4 秒建连超时。
QWEN_IMAGE_CONNECT_TIMEOUT_MS=10000
QWEN_IMAGE_REQUEST_RETRY_COUNT=2
# 同一环境里进行中的百炼文生图。默认 8，给账号约 10 个异步任务留余量。创建任务时、预扣积分前检查。
QWEN_IMAGE_ACTIVE_LIMIT=8
# qwen-image-3.0-pro 进行中的任务。默认 4。Pro 大约 5 RPM，3.0 不单独设这一项。
QWEN_IMAGE_PRO_ACTIVE_LIMIT=4
# 仅预览/本地。true 或 rate 让提交假装返回 Throttling.RateQuota；quota 假装 AllocationQuota。
# VERCEL_ENV=production 或 AIGC_RUNTIME_SCOPE=production 时一律忽略。两个都没设置时也不生效。
QWEN_IMAGE_FORCE_THROTTLE=

# DragonCode GPT-Image-2（工作站「智能编辑」「裂变」「精修」「融合」和「重新打光」）。平台统一 Key，不要用 VITE_ 前缀，也不要做用户自带 Key。
# 未配置时 GET /api/capabilities 的 imageEdit、variation 为 false，智能编辑、精修、融合、重新打光和裂变回到「即将上线」。
# 尺寸和分辨率按每次请求计算，不要设置全局固定 size/resolution。
DRAGONCODE_API_KEY=
DRAGONCODE_BASE_URL=https://dragoncode.codes/gpt-image/v1
DRAGONCODE_IMAGE_MODEL=gpt-image-2
DRAGONCODE_REQUEST_TIMEOUT_MS=30000
DRAGONCODE_REQUEST_RETRY_COUNT=2
DRAGONCODE_POLL_INTERVAL_MS=5000
DRAGONCODE_INITIAL_POLL_DELAY_MS=5000
DRAGONCODE_TASK_TIMEOUT_MS=300000
DRAGONCODE_MAX_PARALLEL=4
# 仅本地联调任务层时开启模拟供应商，生产不要打开。
AIGC_IMAGE_MOCK_PROVIDER=false

# 火山方舟 Seedance 2.0 fast：自由画布文生视频与单张首帧图生视频。
# 先完成数据库迁移、分钟补偿调度、R2 CORS 和真实验收，再打开开关。
# 密钥只放服务端；模型与 720p、5/10 秒、50/100 积分在 shared/video-models.ts 统一定义。
VIDEO_GENERATION_ENABLED=false
ARK_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 上游可以访问的稳定 HTTPS 站点，不要填写有部署保护或登录墙的预览地址。
VIDEO_PUBLIC_BASE_URL=
# 两个密钥应各自使用至少 32 字节的随机值；回调密钥绑定任务 ID 与环境。
SEEDANCE_CALLBACK_SECRET=
VIDEO_CRON_SECRET=

# 仅本地管理命令使用；不部署到 Vercel。
AIGC_ADMIN_DATABASE_URL=
# 管理员补发积分时必填，作为流水中的操作人。
AIGC_ADMIN_OPERATOR=
# 仅本地 PostgreSQL 测试允许关闭 TLS；云端保持 false。
AIGC_DB_LOCAL=false

# 首期积分充值；未完成商品配置和真实验收前保持关闭。
# 套餐币种 CNY 或 USD；Creem 只支持 USD，CNY 时仅可使用 Dodo。
# 以下价格均为含税固定价，商品必须与 shared/billing.ts 一致。
AIGC_PAYMENTS_ENABLED=false
AIGC_CREDIT_CURRENCY=CNY
AIGC_PUBLIC_ORIGIN=http://localhost:5173
# local/preview 仅使用 TEST；production 仅使用 LIVE，不能相互回退。
AIGC_CREEM_TEST_API_KEY=
AIGC_CREEM_TEST_WEBHOOK_SECRET=
AIGC_CREEM_TEST_STARTER_PRODUCT_ID=
AIGC_CREEM_TEST_STANDARD_PRODUCT_ID=
AIGC_CREEM_TEST_STUDIO_PRODUCT_ID=
AIGC_CREEM_LIVE_API_KEY=
AIGC_CREEM_LIVE_WEBHOOK_SECRET=
AIGC_CREEM_LIVE_STARTER_PRODUCT_ID=
AIGC_CREEM_LIVE_STANDARD_PRODUCT_ID=
AIGC_CREEM_LIVE_STUDIO_PRODUCT_ID=
AIGC_DODO_TEST_API_KEY=
AIGC_DODO_TEST_WEBHOOK_SECRET=
AIGC_DODO_TEST_STARTER_PRODUCT_ID=
AIGC_DODO_TEST_STANDARD_PRODUCT_ID=
AIGC_DODO_TEST_STUDIO_PRODUCT_ID=
AIGC_DODO_LIVE_API_KEY=
AIGC_DODO_LIVE_WEBHOOK_SECRET=
AIGC_DODO_LIVE_STARTER_PRODUCT_ID=
AIGC_DODO_LIVE_STANDARD_PRODUCT_ID=
AIGC_DODO_LIVE_STUDIO_PRODUCT_ID=
