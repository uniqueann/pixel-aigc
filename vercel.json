{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["pdx1"],
  "functions": { "api/**/*.ts": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/internal/email-cleanup", "schedule": "0 1 * * *" }],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
