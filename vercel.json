{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["pdx1"],
  "functions": { "api/**/*.ts": { "maxDuration": 120 } },
  "crons": [
    { "path": "/api/internal/email-cleanup", "schedule": "0 1 * * *" },
    { "path": "/api/internal/image-jobs-sweep", "schedule": "5 1 * * *" },
    { "path": "/api/internal/credit-payments-reconcile", "schedule": "10 1 * * *" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/entry?__route=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
