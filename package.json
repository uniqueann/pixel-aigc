{
  "name": "pixel-aigc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:server && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint .",
    "dev:api": "tsx --env-file-if-exists=.env.local scripts/dev-api.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "aigc:invite": "tsx --env-file-if-exists=.env.local scripts/aigc-admin.ts invite",
    "aigc:member": "tsx --env-file-if-exists=.env.local scripts/aigc-admin.ts member",
    "aigc:bootstrap": "tsx --env-file-if-exists=.env.local scripts/aigc-admin.ts bootstrap"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/s3-request-presigner": "3.1127.0",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "^5.51.0",
    "antd": "^5.20.0",
    "axios": "^1.7.4",
    "fabric": "^6.0.2",
    "postgres": "3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "sharp": "0.35.4",
    "zod": "4.5.4",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "supabase": "2.117.0",
    "tsx": "4.23.13",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": "24.x"
  }
}
